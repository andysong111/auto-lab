{
  "name": "playjolt-autonomous-factory",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/contracts.test.cjs tests/orchestrator.test.cjs tests/rc.test.cjs control-plane/tests/control-plane.test.cjs commissioning/tests/commissioning.test.cjs tests/media-settlement.test.cjs qa/tests/preview-route.test.cjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser.test.cjs",
    "test:regression": "node tests/regression.cjs",
    "control:snapshot": "node control-plane/cli.cjs snapshot",
    "control:dashboard": "node control-plane/cli.cjs dashboard",
    "test:worker": "node --test worker/tests/providers.test.cjs worker/tests/worker.test.cjs worker/tests/owner-continuation.test.cjs",
    "test:worker:isolated": "node --test --test-concurrency=1 worker/tests/isolated.test.cjs",
    "test:product": "node --test qa/tests/product.test.cjs",
    "test:product:docker": "node --test --test-concurrency=1 qa/tests/product-docker.test.cjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "playwright": "1.55.0"
  }
}
