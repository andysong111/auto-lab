{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://playjolt.invalid/schema/game-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "game_id", "generation", "version", "title", "slug", "genre", "mechanic_family", "controls", "mobile_controls", "reference_quality_games", "created_at", "state", "repair_attempt", "max_repair_attempts", "source_path", "preview_url", "qa_status", "quality_status", "release_status", "failure_reasons", "metrics_eligibility", "qa", "revision", "history"],
  "properties": {
    "schema_version": {"const": 1},
    "game_id": {"type": "string", "pattern": "^GAME-[0-9]{8}-[0-9]{3,6}$"},
    "generation": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 100},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "genre": {"type": "string", "minLength": 1, "maxLength": 80},
    "mechanic_family": {"type": "string", "minLength": 1, "maxLength": 80},
    "controls": {"$ref": "#/definitions/controls"},
    "mobile_controls": {"$ref": "#/definitions/controls"},
    "reference_quality_games": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}, "allOf": [{"contains": {"const": "astra-sentinel-v3"}}, {"contains": {"const": "deep-descent"}}]},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "state": {"enum": ["IDEA", "SPEC_READY", "BUILDING", "BUILD_FAILED", "QA_RUNNING", "QA_FAILED", "REPAIR_PENDING", "REPAIRING", "QUALITY_GATE", "QUALITY_FAILED", "RC_READY", "PREVIEW_DEPLOYING", "PREVIEW_SMOKE", "READY_TO_SHIP", "REJECTED", "ARCHIVED"]},
    "repair_attempt": {"type": "integer", "minimum": 0, "maximum": 5},
    "max_repair_attempts": {"type": "integer", "minimum": 0, "maximum": 5},
    "source_path": {"type": "string", "pattern": "^autonomy/games/GAME-[0-9]{8}-[0-9]{3,6}/v[1-9][0-9]*$"},
    "preview_url": {"type": ["string", "null"], "pattern": "^https://[a-zA-Z0-9.-]+\\.vercel\\.app(?:/.*)?$"},
    "qa_status": {"enum": ["PENDING", "RUNNING", "PASS", "FAIL"]},
    "quality_status": {"enum": ["PENDING", "PASS", "REPAIR", "REJECT"]},
    "release_status": {"enum": ["NONE", "RC", "PREVIEW", "READY", "REJECTED"]},
    "failure_reasons": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}},
    "metrics_eligibility": {"const": false},
    "qa": {"type": "object", "additionalProperties": false, "required": ["seed", "keyboard", "pointer", "terminal_ms"], "properties": {
      "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
      "keyboard": {"type": "object", "additionalProperties": false, "required": ["key", "observation"], "properties": {"key": {"type": "string", "pattern": "^[a-zA-Z0-9]+$", "maxLength": 30}, "observation": {"type": "string", "pattern": "^state\\.[a-zA-Z0-9_.]+$"}}},
      "pointer": {"type": "object", "additionalProperties": false, "required": ["observation"], "properties": {"observation": {"type": "string", "pattern": "^state\\.[a-zA-Z0-9_.]+$"}}},
      "terminal_ms": {"type": "integer", "minimum": 1000, "maximum": 120000}
    }},
    "revision": {"type": "integer", "minimum": 0},
    "history": {"type": "array", "items": {"type": "object"}},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "branch": {"type": "string", "pattern": "^factory/GAME-[0-9]{8}-[0-9]{3,6}$"},
    "pr_number": {"type": "integer", "minimum": 1},
    "pr_url": {"type": "string", "pattern": "^https://github.com/andysong111/auto-lab/pull/[0-9]+$"},
    "rc_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "deployment_id": {"type": "string"}
  },
  "definitions": {"controls": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 200}}}
}
